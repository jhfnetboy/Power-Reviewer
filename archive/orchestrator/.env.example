# 复制为 .env 并填写。.env 已被 .gitignore 忽略,勿提交。
LITELLM_BASE=http://localhost:4000
OLLAMA_BASE=http://localhost:11434

# 升级大脑的每日硬上限(防爆订阅配额,见研究文档 §1 约束二)
ESCALATE_DAILY_CAP=10

# 升级大脑只走官方 CLI,不在此放任何 OAuth token / API key。
# 若确需直连 Anthropic/OpenAI API(非订阅,按量计费),才在此放对应 API key:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
