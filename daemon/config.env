# reviewerd 配置(被 reviewerd.sh / discover.sh source)
POLL_INTERVAL=300                                  # P0 轮询间隔(秒)
ORGS_CONF="$HOME/.config/prbot/repos.conf"         # 复用 prbot 的 org 列表(单一真相源:AAStarCommunity/AuraAIHQ/MushroomDAO)
OPENCODE_AGENT="pr-reviewer"                        # opencode.json 里的编排 agent
STATE_DIR="$HOME/.local/state/power-reviewer"       # 去重/状态/巡检账本
SWEEP_PER_CYCLE=1                                   # 每轮最多推进几个背景巡检任务(长线、低优先)
ESCALATE_DAILY_CAP=8                               # 升级大脑每日硬上限(防爆订阅配额)
ESCALATE_CLI="claude"                              # 官方 CLI 升级:claude -p(或 codex exec)。绝不喂 OAuth token 给第三方

# 直评(路径2,非 agentic)
REVIEW_MODEL="omlx/Qwen2.5-Coder-32B-Instruct-MLX-8bit"
REVIEW_LENSES="security,testing,docs,consistency"
OMLX_BASE="http://localhost:8088/v1"
# OMLX_API_KEY 别写在这里(会进仓库)。在 launchd plist 的 EnvironmentVariables 或 shell 里 export。
# DRY_RUN=1                                        # 设了就只打印不发评论(联调期建议先开)
