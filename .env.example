# Power-Reviewer 配置模板。复制为 .env 并填好(.env 已被 .gitignore 忽略,勿提交)。
#   cp .env.example .env && $EDITOR .env

# ── omlx 本地推理 ──
OMLX_API_KEY=填你的omlx密钥          # 如 xiaobao8088;别提交 .env
OMLX_BASE=http://localhost:8088/v1

# ── 审查模型与维度 ──
REVIEW_MODEL=omlx/Qwen3-Coder-30B-A3B-Instruct-MLX-8bit   # 备选 Qwen3-Coder-Next 需 4bit(~40GB)
REVIEW_LENSES=security,testing,docs,consistency
MAX_INLINE=10                        # 每个 PR 最多发几条 inline 评论(降噪)
MAX_DIFF_CHARS=40000                 # 超此长度截断(TODO: token 分块)

# ── 调度 / 节奏 ──
POLL_INTERVAL=300                    # 轮询间隔(秒)
MAX_REVIEWS_PER_CYCLE=3              # 每轮最多审几个新 PR(防第一轮 marathon)
SWEEP_PER_CYCLE=1                    # P2 背景巡检每轮推进数(待实现)
DRY_RUN=1                            # 1=只审不发(观察期);改 0 才真发评论

# ── 发现范围(复用 prbot)/ 状态 ──
ORGS_CONF=$HOME/.config/prbot/repos.conf   # 你的 3 个 org
STATE_DIR=$HOME/.local/state/power-reviewer

# ── 升级深审(可选,官方 CLI,合规)──
ESCALATE_DAILY_CAP=8
ESCALATE_CLI=claude                  # claude -p / codex exec;绝不喂 OAuth token 给第三方

# ── 代理(本地请求别走 Clash 7890)──
NO_PROXY=localhost,127.0.0.1
